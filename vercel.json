{
  "version": 2,
  "rewrites": [
    {
      "source": "/(login|register|logout|me|upload|ask|document-info|history|health|admin/.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/script.js",
      "destination": "/frontend/script.js"
    },
    {
      "source": "/app/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
